# 复制为 .env（本地 / docker compose 用）；Railway 请在 Variables 面板里填同名变量
# 生成随机口令：openssl rand -hex 24

# 用户 token。只在「首次启动」时用来给数据库灌种子，之后增删改都在管理台做。
# 多人共用时用逗号分隔，每个 token 拥有独立坐标，互不干扰：
#   TOKEN=<token1>,<token2>,<token3>
TOKEN=

# 管理台口令。设了才有 /admin 页面（没设的话该路径直接 404）。
# 必须和上面任何一个用户 token 都不同，否则启动会拒绝。
ADMIN_TOKEN=

# 可选：高德 Web 服务 key。填了之后选点页的搜索走高德 POI（0.3 秒，国内数据全），
#       保存坐标时还会自动把地址名逆解出来存进库，管理台就能看到「浙江省杭州市西湖区天堂软件园」
#       而不是一串经纬度。不填则完全退回 Nominatim，功能不会坏，只是慢些、没有地址名。
#       申请：https://console.amap.com/ -> 应用管理 -> 新建应用 -> 添加 Key -> 服务平台选「Web服务」
#       注意：Web 服务 key 没有域名限制，泄露即被人白嫖配额，只放这里、别提交进仓库。
AMAP_KEY=

# 可选：监听端口，Railway 上留空即可（默认 8080，与 Dockerfile 的 EXPOSE 一致）
# PORT=8080
# 可选：数据目录锚点。Railway 挂载 Volume 到 /data 时保持这个值；
#       数据库会落在同目录下的 app.db
# DATA_FILE=/data/loc.json
# 可选：信任几层反向代理来判定客户端真实 IP。
#       X-Forwarded-For 是每层代理往「尾部」追加的，所以最左边那段是客户端自己写的、可以伪造，
#       必须从右往左数。Railway / 大多数 PaaS 前面是一层边缘代理 —— 默认 1，不用改。
#       裸机直连公网（前面没有任何代理）请设成 0，只信 socket 地址。
# TRUST_PROXY_HOPS=1
# 可选：日志按 UTC+8 分天，其它时区改这里（分钟）
# TZ_OFFSET_MIN=480
# 可选：日志保留最近 N 个完整月 + 当月（归档与删除按自然月对齐）
# LOG_RETENTION_MONTHS=3
# 可选：日志行数硬上限，超出时提前按天归档并删除
# LOG_MAX_ROWS=500000
# 可选：归档文件最多保留几个月，超出自动删最旧的
# ARCHIVE_KEEP_MONTHS=24
# 可选：daily 预聚合表保留天数（它很小，留得比明细久，看板曲线才不会断）
# DAILY_RETENTION_DAYS=400
